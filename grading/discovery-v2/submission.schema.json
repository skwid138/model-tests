{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:model-tests:discovery-v2:normalized-submission:v2",
  "title": "Coordinator-normalized Discovery Benchmark v2 submission",
  "description": "Coordinator-only transcription of public <results> output, typed fragment, citations, prose, and independent reviews. Never give this file to a measured worker.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "taskVersion", "sourceVersion", "resultsText", "typedFragment", "answers", "evidenceReviews", "claimReviews"],
  "properties": {
    "schemaVersion": {"const": 2},
    "caseId": {"enum": ["trace", "boundary"]},
    "taskVersion": {"const": 2},
    "sourceVersion": {"const": 2},
    "resultsText": {"type": "string", "minLength": 1, "description": "The exact public <results> envelope, excluding <analysis>; only an explicit trial-root citation prefix may be normalized."},
    "typedFragment": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["status", "facts"], "properties": {"status": {"const": "valid"}, "facts": {"description": "The parsed JSON value. Root or question-shape errors are graded as invalid typed data."}}},
        {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"const": "missing"}}},
        {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "invalid"}, "reason": {"type": "string", "minLength": 1}}}
      ]
    },
    "answers": {
      "type": "object",
      "propertyNames": {"pattern": "^[TB][1-3]$"},
      "additionalProperties": {"$ref": "#/$defs/questionAnswer"}
    },
    "evidenceReviews": {
      "type": "array",
      "description": "One fact-linked record may omit reviewer A or B to preserve a missing review; it remains UNRESOLVED.",
      "items": {"$ref": "#/$defs/evidenceReview"}
    },
    "claimReviews": {
      "type": "array",
      "description": "One claim-linked record may omit reviewer A or B to preserve a missing review; it remains UNRESOLVED.",
      "items": {"$ref": "#/$defs/claimReview"}
    }
  },
  "allOf": [
    {"if": {"properties": {"caseId": {"const": "trace"}}, "required": ["caseId"]}, "then": {"properties": {"answers": {"required": ["T1", "T2", "T3"]}}}},
    {"if": {"properties": {"caseId": {"const": "boundary"}}, "required": ["caseId"]}, "then": {"properties": {"answers": {"required": ["B1", "B2", "B3"]}}}}
  ],
  "$defs": {
    "questionAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prose", "citations", "additionalClaims"],
      "properties": {
        "prose": {"type": "string", "description": "Faithful transcription of answer prose for this question; do not rewrite it to improve scoring."},
        "citations": {"type": "array", "items": {"$ref": "#/$defs/factCitation"}},
        "additionalClaims": {"type": "array", "items": {"$ref": "#/$defs/additionalClaim"}}
      }
    },
    "factCitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factId", "path", "startLine", "endLine"],
      "properties": {
        "factId": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "startLine": {"type": "integer", "minimum": 1},
        "endLine": {"type": "integer", "minimum": 1}
      }
    },
    "locationCitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "startLine", "endLine"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "startLine": {"type": "integer", "minimum": 1},
        "endLine": {"type": "integer", "minimum": 1}
      }
    },
    "additionalClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "citations"],
      "properties": {
        "id": {"type": "string", "pattern": "^[TB][1-3]-C[0-9]{2,}$"},
        "text": {"type": "string", "minLength": 1},
        "citations": {"type": "array", "items": {"$ref": "#/$defs/locationCitation"}}
      }
    },
    "evidenceChecklist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citationsEntailClaim", "branchCoverageComplete"],
      "properties": {"citationsEntailClaim": {"type": "boolean"}, "branchCoverageComplete": {"type": "boolean"}}
    },
    "evidenceReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionId", "factId"],
      "properties": {
        "questionId": {"type": "string", "pattern": "^[TB][1-3]$"},
        "factId": {"type": "string", "minLength": 1},
        "reviewerA": {"$ref": "#/$defs/evidenceChecklist"},
        "reviewerB": {"$ref": "#/$defs/evidenceChecklist"}
      }
    },
    "claimChecklist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimAtomic", "sourceScopeComplete", "reviewCompleted", "evidenceDisposition"],
      "properties": {
        "claimAtomic": {"type": "boolean"},
        "sourceScopeComplete": {"type": "boolean"},
        "reviewCompleted": {"type": "boolean"},
        "evidenceDisposition": {"enum": ["supported", "unsupported_established", "contradicted", "not_reviewed"]}
      }
    },
    "claimReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionId", "claimId"],
      "properties": {
        "questionId": {"type": "string", "pattern": "^[TB][1-3]$"},
        "claimId": {"type": "string", "pattern": "^[TB][1-3]-C[0-9]{2,}$"},
        "reviewerA": {"$ref": "#/$defs/claimChecklist"},
        "reviewerB": {"$ref": "#/$defs/claimChecklist"}
      }
    }
  }
}
